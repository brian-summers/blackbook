# Normalize line endings so a Windows contributor can't ship CRLF that breaks
# `#!/bin/bash` scripts or the Docker build on Linux.
* text=auto eol=lf

# Shell scripts and Dockerfiles MUST be LF regardless of local settings.
*.sh    text eol=lf
*.env   text eol=lf
Dockerfile text eol=lf
*.conf  text eol=lf

# PowerShell scripts are used on Windows — keep CRLF.
*.ps1   text eol=crlf

# Binary / non-diffable assets.
*.png   binary
*.jpg   binary
*.drawio binary
Cargo.lock -diff
LICENSE  -diff
