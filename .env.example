# Blackbook — environment template. Copy to `.env` in the project root and change
# every password before `docker compose up`:
#     cp .env.example .env   &&   $EDITOR .env
# docker-compose.yml substitutes exactly these variable names. (`.env` is
# gitignored; this template is not.) `config/blackbook.env` is a fuller,
# annotated version of the same variables.

# --- PostgreSQL superuser (init / break-glass only; NOT used by the app) ------
DB_ADMIN_USER=blackbook_admin
# CHANGE ME. Generate: openssl rand -base64 32
DB_ADMIN_PASSWORD=change_me_admin_password

# --- Least-privilege application role (the app connects as this over mTLS) -----
DB_USER=blackbook_app
# CHANGE ME. Generate: openssl rand -base64 32
DB_PASSWORD=change_me_app_password

# --- Optional read-only backup role (created only if a password is set) --------
BACKUP_PASSWORD=

# --- Database name -------------------------------------------------------------
DB_NAME=blackbook

# --- Application -------------------------------------------------------------—-
# Log filter. Use info/warn/error in production (avoid debug — it is verbose).
RUST_LOG=info

# Extra SANs for the auto-minted server cert, if clients reach the server by a
# hostname other than localhost/127.0.0.1/blackbook/blackbook-app. Set BEFORE
# first boot (the cert is generated once).
# BLACKBOOK_SERVER_SANS=localhost,127.0.0.1,vault.example.com
