        <mxCell id="d_bar" style="rounded=1;arcSize=40;fillColor=#2d7d7d;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="6" height="46" as="geometry"/></mxCell>
        <mxCell id="d_title" value="Data Model — PostgreSQL (encrypted at rest)" style="text;html=1;fontSize=22;fontStyle=1;align=left;fontColor=#1f2d3d;" vertex="1" parent="1"><mxGeometry x="60" y="16" width="900" height="28" as="geometry"/></mxCell>
        <mxCell id="d_legend" value="&lt;b&gt;&lt;font color=&quot;#9a7d12&quot;&gt;At-rest scheme&lt;/font&gt;&lt;/b&gt;&#160;&#160;user identifiers are stored as &lt;b&gt;*_enc&lt;/b&gt; (AEAD under metadata_enc_key); deterministic lookups go through &lt;b&gt;*_id&lt;/b&gt; HMAC columns (name_index_key, domain-separated).&#160;&#160;A DB-only attacker sees opaque ids, ciphertext, timestamps, and a small action vocabulary." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;shadow=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1520" height="48" as="geometry"/></mxCell>

        <mxCell id="grp_id" value="IDENTITY &amp; ACCESS CONTROL" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=11;fontStyle=1;fontColor=#2f5076;fillColor=none;strokeColor=#6c8ebf;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="30" y="122" width="1270" height="186" as="geometry"/></mxCell>
        <mxCell id="grp_res" value="RESOURCES" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=11;fontStyle=1;fontColor=#3f6b2f;fillColor=none;strokeColor=#82b366;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="30" y="320" width="1130" height="230" as="geometry"/></mxCell>
        <mxCell id="grp_appr" value="APPROVALS &amp; AUDIT" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=11;fontStyle=1;fontColor=#6c4f86;fillColor=none;strokeColor=#9673a6;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="30" y="562" width="1530" height="170" as="geometry"/></mxCell>

        <mxCell id="t_domains" value="&lt;b&gt;blackbook_domains&lt;/b&gt;&#10;─────────────&#10;id (PK)&#10;name_enc · name_id&#10;description_enc" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;shadow=1;align=left;spacingLeft=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=11;verticalAlign=top;spacingTop=6;fontColor=#23456b;" vertex="1" parent="1"><mxGeometry x="50" y="150" width="240" height="120" as="geometry"/></mxCell>
        <mxCell id="t_members" value="&lt;b&gt;blackbook_domain_members&lt;/b&gt;&#10;─────────────&#10;domain_id (FK) · client_id (FK)&#10;role  (user | guest | admin)&#10;&lt;i&gt;role=admin ⇒ domain admin&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;shadow=1;align=left;spacingLeft=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=11;verticalAlign=top;spacingTop=6;fontColor=#23456b;" vertex="1" parent="1"><mxGeometry x="340" y="150" width="270" height="120" as="geometry"/></mxCell>
