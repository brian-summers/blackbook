        <mxCell id="t_title" value="Blackbook — System Architecture" style="text;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1f2d3d;" vertex="1" parent="1"><mxGeometry x="60" y="14" width="900" height="30" as="geometry"/></mxCell>
        <mxCell id="t_sub" value="Rust · Actix-web HTTPS + mutual-TLS · PostgreSQL · Docker&#160;&#160;—&#160;&#160;src/{main, server, client, auth, blackbook_core, persistence, credstore}.rs" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#5b6b7e;" vertex="1" parent="1"><mxGeometry x="61" y="44" width="1100" height="18" as="geometry"/></mxCell>

        <mxCell id="lg_t" value="control flow&#160;&#160;&#160;&#9472;&#9472;&#9658;&#160;&#160;&#160;&#160;&#160;data / lookup&#160;&#160;&#160;&#9476;&#9476;&#9658;" style="text;html=1;fontSize=11;align=right;fontColor=#5b6b7e;" vertex="1" parent="1"><mxGeometry x="1180" y="44" width="480" height="18" as="geometry"/></mxCell>

        <mxCell id="z_client" value="&#128421;&#160;&#160;CLIENT HOST" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=15;fontStyle=1;fontColor=#2f5076;fillColor=#dae8fc;gradientColor=#f3f7fd;gradientDirection=north;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="78" width="1620" height="300" as="geometry"/></mxCell>
        <mxCell id="z_server" value="&#9881;&#160;&#160;BLACKBOOK API SERVER&#160;&#160;·&#160;&#160;Actix-web (HTTPS only)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=15;fontStyle=1;fontColor=#3f6b2f;fillColor=#d5e8d4;gradientColor=#f3faf2;gradientDirection=north;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="1000" height="490" as="geometry"/></mxCell>
        <mxCell id="z_crypto" value="&#128273;&#160;&#160;CRYPTO CORE&#160;&#160;·&#160;&#160;blackbook_core.rs" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=15;fontStyle=1;fontColor=#6c4f86;fillColor=#e1d5e7;gradientColor=#f7f3f9;gradientDirection=north;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1060" y="500" width="600" height="490" as="geometry"/></mxCell>
        <mxCell id="z_persist" value="&#128190;&#160;&#160;PERSISTENCE" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=15;fontStyle=1;fontColor=#555555;fillColor=#f0f0f0;gradientColor=#fafafa;gradientDirection=north;strokeColor=#888888;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1015" width="1620" height="255" as="geometry"/></mxCell>

        <mxCell id="c_cli" value="&lt;b&gt;&lt;font color=&quot;#345d8a&quot;&gt;blackbook CLI&lt;/font&gt;&lt;/b&gt;&#160;&lt;font color=&quot;#7e8aa0&quot;&gt;(clap)&lt;/font&gt;&lt;br&gt;&lt;br&gt;login · unlock · lock&lt;br&gt;put · get · ls · rm&lt;br&gt;file put/get  (-e ext · -E resident)&lt;br&gt;acl · domain · client&lt;br&gt;mfa · approve · requests&lt;br&gt;grants · audit · cleanup&lt;br&gt;&lt;br&gt;&lt;i&gt;domain use&lt;/i&gt; → per-profile default domain" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="70" y="128" width="250" height="230" as="geometry"/></mxCell>
        <mxCell id="c_profile" value="&lt;b&gt;&lt;font color=&quot;#345d8a&quot;&gt;Encrypted profile&lt;/font&gt;&lt;/b&gt;&#160;&lt;font color=&quot;#7e8aa0&quot;&gt;~/.bbk/profiles/&amp;lt;name&amp;gt;.json&lt;/font&gt;&lt;br&gt;v2: Argon2id + AES-256-GCM&lt;br&gt;{ server · token · cert · key · ca · &lt;b&gt;CMK&lt;/b&gt; }&lt;br&gt;&lt;i&gt;no secret in cleartext&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="355" y="128" width="300" height="120" as="geometry"/></mxCell>
        <mxCell id="c_agent" value="&lt;b&gt;&lt;font color=&quot;#345d8a&quot;&gt;Unlock agent&lt;/font&gt;&lt;/b&gt;&#160;&lt;font color=&quot;#7e8aa0&quot;&gt;~/.bbk/agent/&amp;lt;profile&amp;gt;&lt;/font&gt;&lt;br&gt;cached derived KEK + TTL&lt;br&gt;&lt;i&gt;(holds no credentials)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="355" y="268" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="c_pointers" value="&lt;b&gt;&lt;font color=&quot;#345d8a&quot;&gt;Pointers&lt;/font&gt;&lt;/b&gt;&lt;br&gt;active → current profile&lt;br&gt;domains/&amp;lt;p&amp;gt; → default domain" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="690" y="128" width="250" height="80" as="geometry"/></mxCell>
        <mxCell id="c_resident" value="&lt;b&gt;&lt;font color=&quot;#345d8a&quot;&gt;Resident stash&lt;/font&gt;&lt;/b&gt;&lt;br&gt;~/.bbk/resident/&amp;lt;id&amp;gt;.bbkr&lt;br&gt;+ index.json&lt;br&gt;&lt;i&gt;client-held file ciphertext&lt;/i&gt;&lt;br&gt;BBKR | header | ct" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="690" y="223" width="250" height="135" as="geometry"/></mxCell>
        <mxCell id="c_clientcrypto" value="&lt;b&gt;&lt;font color=&quot;#345d8a&quot;&gt;Client-side crypto&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;CMK — rotation-stable, carried&lt;br&gt;forward across re-login&lt;br&gt;Argon2id(passphrase)&lt;br&gt;AES-256-GCM envelopes&lt;br&gt;split key:  Kf = Kf_c ⊕ Kf_s" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="985" y="128" width="300" height="230" as="geometry"/></mxCell>
        <mxCell id="c_modes" value="&lt;b&gt;&lt;font color=&quot;#6c4f86&quot;&gt;Client-side storage modes&lt;/font&gt;&lt;/b&gt;&#160;&lt;font color=&quot;#9a8bb0&quot;&gt;(page 4)&lt;/font&gt;&lt;br&gt;&lt;br&gt;① &lt;b&gt;external-key&lt;/b&gt; (-e): ciphertext stored in&lt;br&gt;blackbook; client holds the wrap key.&lt;br&gt;default kek = CMK · passphrase → Argon2id&lt;br&gt;&lt;br&gt;② &lt;b&gt;resident&lt;/b&gt; (-E): ciphertext stays on the&lt;br&gt;client; server holds only its half (Kf_s) of a&lt;br&gt;split key + manifest — mutual custody.&lt;br&gt;--server-copy keeps an opaque backup." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#f6f1fb;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1320" y="128" width="320" height="230" as="geometry"/></mxCell>

        <mxCell id="z_transport" value="&lt;b&gt;&lt;font color=&quot;#9a6a00&quot; style=&quot;font-size:13px&quot;&gt;&#128274;&#160;&#160;SECURE TRANSPORT&lt;/font&gt;&lt;/b&gt;&#160;&#160;—&#160;&#160;TLS 1.3 (AEAD)&#160;&#160;∧&#160;&#160;mutual TLS: client cert (CN + SHA3-256 fingerprint)&#160;&#160;∧&#160;&#160;Bearer token (SHA3-256 at rest)&lt;br&gt;&lt;font color=&quot;#6b6150&quot;&gt;BOTH factors required on every request and must resolve to the same client — no cert-only or token-only path&#160;&#160;(AuthMethod = MutualTlsAndToken)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;shadow=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;gradientColor=#fff6ec;gradientDirection=north;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="398" width="1620" height="78" as="geometry"/></mxCell>

        <mxCell id="s_onconnect" value="&lt;b&gt;on_connect&lt;/b&gt;&#160;&#160;extract client-cert CN + SHA3-256 fingerprint → request extensions" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="70" y="548" width="600" height="46" as="geometry"/></mxCell>
        <mxCell id="s_extractor" value="&lt;b&gt;&lt;font color=&quot;#9a7d12&quot;&gt;AuthenticatedClient&lt;/font&gt;&lt;/b&gt;&#160;&lt;font color=&quot;#7e8aa0&quot;&gt;(FromRequest)&lt;/font&gt;&#160;&#160;cert CN+fp ∧ bearer-token hash → same client; reject expired / revoked" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="70" y="606" width="600" height="56" as="geometry"/></mxCell>
        <mxCell id="s_domain" value="&lt;b&gt;resolve_and_gate_domain&lt;/b&gt;&#160;&#160;?domain= → domain_id · caller must be a member" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="70" y="674" width="600" height="46" as="geometry"/></mxCell>
        <mxCell id="s_acl" value="&lt;b&gt;&lt;font color=&quot;#9a7d12&quot;&gt;acl_check&lt;/font&gt;&lt;/b&gt;&#160;&lt;font color=&quot;#7e8aa0&quot;&gt;authorization core&lt;/font&gt;&lt;br&gt;global admin&#160;&#160;→&#160;&#160;domain admin (role=admin here)&#160;&#160;→&#160;&#160;ACL rule&lt;br&gt;direct or @group · within time window · under max_uses" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="70" y="734" width="600" height="64" as="geometry"/></mxCell>
        <mxCell id="s_flags" value="&lt;b&gt;resource flags&lt;/b&gt;&#160;&#160;mfa_required · delete_on_read · max_reads · rotate_on_read · no_overwrite · preserve_on_cleanup" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="70" y="810" width="600" height="48" as="geometry"/></mxCell>
        <mxCell id="s_kofn" value="&lt;b&gt;&lt;font color=&quot;#9a7d12&quot;&gt;K-of-N threshold gate&lt;/font&gt;&lt;/b&gt;&#160;&#160;create/await approval request · approvers = live signatories ∪ advance grants" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="70" y="870" width="600" height="56" as="geometry"/></mxCell>
        <mxCell id="s_handlers" value="&lt;b&gt;&lt;font color=&quot;#3f6b2f&quot;&gt;Endpoint handlers&lt;/font&gt;&lt;/b&gt;&lt;br&gt;secrets · files · admin&lt;br&gt;acl · domain · client · mfa&lt;br&gt;approve · requests · grants&lt;br&gt;cleanup (tombstone purge)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="710" y="572" width="300" height="130" as="geometry"/></mxCell>
        <mxCell id="s_audit" value="&lt;b&gt;&lt;font color=&quot;#3f6b2f&quot;&gt;Audit log&lt;/font&gt;&lt;/b&gt;&lt;br&gt;keyed SHA3-256 hash chain&lt;br&gt;append-only · tamper-evident&lt;br&gt;audit --verify" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="710" y="740" width="300" height="86" as="geometry"/></mxCell>

        <mxCell id="k_root" value="&lt;b&gt;&lt;font color=&quot;#6c4f86&quot;&gt;BlackbookKey&lt;/font&gt;&lt;/b&gt;&#160;&#160;root &lt;b&gt;PrimaryKey&lt;/b&gt; (32 B CSPRNG)&lt;br&gt;+ WrappedKey: 30× RFC 3394 AES key-wrap" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1085" y="545" width="550" height="62" as="geometry"/></mxCell>
        <mxCell id="k_secondary" value="&lt;b&gt;&lt;font color=&quot;#6c4f86&quot;&gt;SecondaryKeys&lt;/font&gt;&lt;/b&gt;&#160;&lt;font color=&quot;#9a8bb0&quot;&gt;(domain-separated)&lt;/font&gt;&lt;br&gt;secret_layer1 · secret_layer2 · file_dek_kek&lt;br&gt;index · hmac · mfa_secret_kek" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1085" y="620" width="550" height="84" as="geometry"/></mxCell>
        <mxCell id="k_derived" value="&lt;b&gt;&lt;font color=&quot;#6c4f86&quot;&gt;Derived keys&lt;/font&gt;&lt;/b&gt;&lt;br&gt;metadata_enc_key → AEAD on every stored identifier&lt;br&gt;name_index_key → HMAC name_id lookup columns" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1085" y="718" width="550" height="62" as="geometry"/></mxCell>
        <mxCell id="k_algos" value="&lt;b&gt;&lt;font color=&quot;#6c4f86&quot;&gt;Algorithms&lt;/font&gt;&lt;/b&gt;&#160;&lt;font color=&quot;#9a8bb0&quot;&gt;(page 3)&lt;/font&gt;&lt;br&gt;AES-256-GCM (aead_seal / aead_open)&lt;br&gt;scrypt  n=2¹² r=16 p=4  (per-message envelopes + DEK)&lt;br&gt;Argon2id  64 MiB / t=3  — password paths only&lt;br&gt;&lt;i&gt;Secrets: 2-layer AES-GCM · external rows re-wrapped at rest&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1085" y="794" width="550" height="130" as="geometry"/></mxCell>

        <mxCell id="p_postgres" value="&lt;b&gt;&lt;font color=&quot;#444444&quot;&gt;PostgreSQL&lt;/font&gt;&lt;/b&gt;&#160;&#160;every user identifier encrypted at rest (*_enc) + HMAC (*_id) lookup columns&#160;&#160;&lt;font color=&quot;#8a8a8a&quot;&gt;(page 5)&lt;/font&gt;&lt;br&gt;&lt;br&gt;domains · domain_members · clients · acl · secrets · pages · contents&lt;br&gt;access_requests · access_grants · audit · schema_migrations&lt;br&gt;&lt;br&gt;&lt;i&gt;secrets&lt;/i&gt;: is_external · external_envelope · flags · access_policy · exhausted_at&lt;br&gt;&lt;i&gt;pages&lt;/i&gt;: external_kind (0 normal / 1 external-key / 2 resident) · server_key_component · has_server_copy" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;shadow=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="70" y="1060" width="930" height="180" as="geometry"/></mxCell>
        <mxCell id="p_disk" value="&lt;b&gt;&lt;font color=&quot;#444444&quot;&gt;/opt/blackbook/data&lt;/font&gt;&lt;/b&gt;&#160;&lt;font color=&quot;#8a8a8a&quot;&gt;Docker volume&lt;/font&gt;&lt;br&gt;&lt;br&gt;master.bbkey&#160;&#160;·&#160;&#160;dek + dek.mode&lt;br&gt;ca.crt / ca.key&#160;&#160;·&#160;&#160;server.crt / server.key&lt;br&gt;admin-bundle.json&lt;br&gt;contents/&amp;lt;id&amp;gt; — encrypted file blobs&lt;br&gt;(+ opt-in resident backups)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;shadow=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1030" y="1060" width="600" height="180" as="geometry"/></mxCell>

        <mxCell id="e1" value="load + decrypt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7589a6;strokeWidth=1.5;fontSize=10;fontColor=#33415c;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c_cli" target="c_profile"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="cached KEK unlocks" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7589a6;strokeWidth=1.5;fontSize=10;fontColor=#33415c;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_agent" target="c_profile"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="seal / open" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7589a6;strokeWidth=1.5;fontSize=10;fontColor=#33415c;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_cli" target="c_clientcrypto"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="HTTPS request" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#5b6b87;strokeWidth=2;fontSize=11;fontColor=#33415c;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.12;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_cli" target="z_transport"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#5b6b87;strokeWidth=2;exitX=0.12;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="z_transport" target="s_onconnect"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7589a6;strokeWidth=1.5;" edge="1" parent="1" source="s_onconnect" target="s_extractor"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7589a6;strokeWidth=1.5;" edge="1" parent="1" source="s_extractor" target="s_domain"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7589a6;strokeWidth=1.5;" edge="1" parent="1" source="s_domain" target="s_acl"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7589a6;strokeWidth=1.5;" edge="1" parent="1" source="s_acl" target="s_flags"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7589a6;strokeWidth=1.5;" edge="1" parent="1" source="s_flags" target="s_kofn"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="authorized" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#5b8a3f;strokeWidth=2;fontSize=11;fontColor=#3f6b2f;fontStyle=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.9;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_kofn" target="s_handlers"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" value="rules · members" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;strokeColor=#9aa7bd;strokeWidth=1.5;fontSize=10;fontColor=#5b6b7e;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.04;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_acl" target="p_postgres"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="58" y="766"/><mxPoint x="58" y="1110"/></Array></mxGeometry></mxCell>
        <mxCell id="e13" value="encrypt / decrypt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#9673a6;strokeWidth=1.5;fontSize=10;fontColor=#6c4f86;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_handlers" target="k_secondary"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e17" value="log" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7589a6;strokeWidth=1.5;fontSize=10;fontColor=#33415c;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_handlers" target="s_audit"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e15" value="rows" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7589a6;strokeWidth=1.5;fontSize=10;fontColor=#33415c;labelBackgroundColor=#ffffff;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_audit" target="p_postgres"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e16" value="file blobs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7589a6;strokeWidth=1.5;fontSize=10;fontColor=#33415c;labelBackgroundColor=#ffffff;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0.08;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_handlers" target="p_disk"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" value="master.bbkey · DEK (boot)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;strokeColor=#9aa7bd;strokeWidth=1.5;fontSize=10;fontColor=#5b6b7e;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_disk" target="k_algos"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="p2_authz" name="2 · Authorization Pipeline">
    <mxGraphModel dx="1422" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="1520" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="q_bar" style="rounded=1;arcSize=40;fillColor=#d6b656;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="6" height="46" as="geometry"/></mxCell>
        <mxCell id="q_title" value="Request Authorization Pipeline" style="text;html=1;fontSize=22;fontStyle=1;align=left;fontColor=#1f2d3d;" vertex="1" parent="1"><mxGeometry x="60" y="16" width="900" height="28" as="geometry"/></mxCell>
        <mxCell id="q_sub" value="Every gate, in order — the green spine is the happy path; each gate branches right to the exact HTTP status its denial returns. The audit log records every outcome, success or denial." style="text;html=1;fontSize=12;align=left;fontColor=#5b6b7e;" vertex="1" parent="1"><mxGeometry x="61" y="44" width="1000" height="30" as="geometry"/></mxCell>

        <mxCell id="spine" value="" style="rounded=1;arcSize=20;fillColor=#eef6ea;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="300" y="90" width="430" height="1320" as="geometry"/></mxCell>

        <mxCell id="a_req" value="HTTPS request arrives" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;shadow=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#2f5076;" vertex="1" parent="1"><mxGeometry x="355" y="104" width="320" height="44" as="geometry"/></mxCell>

        <mxCell id="a_tls" value="&lt;b&gt;TLS 1.3 handshake&lt;/b&gt;&#10;server cert chains to Blackbook CA · client presents its cert" style="rhombus;whiteSpace=wrap;html=1;shadow=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="335" y="174" width="360" height="96" as="geometry"/></mxCell>
        <mxCell id="f_tls" value="&#10005;&#160;&lt;b&gt;TLS alert&lt;/b&gt;&#10;connection refused" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=11;fontColor=#8a302b;" vertex="1" parent="1"><mxGeometry x="850" y="194" width="300" height="50" as="geometry"/></mxCell>

        <mxCell id="a_onconnect" value="&lt;b&gt;on_connect&lt;/b&gt;&#160;&#160;capture client-cert CN + SHA3-256 fingerprint" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="355" y="300" width="320" height="44" as="geometry"/></mxCell>

        <mxCell id="a_auth" value="&lt;b&gt;AuthenticatedClient&lt;/b&gt;&#160;(FromRequest)&#10;cert CN+fp  AND  bearer-token SHA3 hash → the SAME client&#10;client not expired / not revoked" style="rhombus;whiteSpace=wrap;html=1;shadow=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="325" y="372" width="380" height="110" as="geometry"/></mxCell>
        <mxCell id="f_auth" value="&#10005;&#160;&lt;b&gt;401 Unauthorized&lt;/b&gt;&#10;missing/mismatched factor, expired, or revoked" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=11;fontColor=#8a302b;" vertex="1" parent="1"><mxGeometry x="850" y="397" width="300" height="60" as="geometry"/></mxCell>

        <mxCell id="a_domain" value="&lt;b&gt;resolve_and_gate_domain&lt;/b&gt;&#10;?domain= → domain_id · caller must be a member" style="rhombus;whiteSpace=wrap;html=1;shadow=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="335" y="522" width="360" height="96" as="geometry"/></mxCell>
        <mxCell id="f_domain" value="&#10005;&#160;&lt;b&gt;403 Forbidden&lt;/b&gt; (not a member)&#10;&#10005;&#160;&lt;b&gt;404&lt;/b&gt; unknown domain" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=11;fontColor=#8a302b;" vertex="1" parent="1"><mxGeometry x="850" y="540" width="300" height="60" as="geometry"/></mxCell>

        <mxCell id="a_acl" value="&lt;b&gt;acl_check&lt;/b&gt;&#160;&#160;authorization core&#10;1.&#160;global admin → allow&#10;2.&#160;domain admin (role=admin here) → allow&#10;3.&#160;direct / @group ACL rule · in [not_before, expires_at] · use_count &lt; max_uses" style="rhombus;whiteSpace=wrap;html=1;shadow=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="315" y="672" width="400" height="128" as="geometry"/></mxCell>
        <mxCell id="f_acl" value="&#10005;&#160;&lt;b&gt;403 Forbidden&lt;/b&gt;&#10;no admin path and no in-window unspent rule" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=11;fontColor=#8a302b;" vertex="1" parent="1"><mxGeometry x="850" y="702" width="300" height="60" as="geometry"/></mxCell>

        <mxCell id="a_store" value="&lt;b&gt;on store only&lt;/b&gt;&#160;—&#160;read-only by default&#10;exists &amp; !overwrite → conflict · no_overwrite → immutable" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="355" y="838" width="320" height="52" as="geometry"/></mxCell>
        <mxCell id="f_store" value="&#10005;&#160;&lt;b&gt;409 Conflict&lt;/b&gt;&#10;already_exists / immutable" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=11;fontColor=#8a302b;" vertex="1" parent="1"><mxGeometry x="850" y="840" width="300" height="48" as="geometry"/></mxCell>

        <mxCell id="a_flags" value="&lt;b&gt;resource flags / lifecycle&lt;/b&gt;&#10;tombstoned? · mfa_required? · max_reads reached?" style="rhombus;whiteSpace=wrap;html=1;shadow=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="335" y="922" width="360" height="108" as="geometry"/></mxCell>
        <mxCell id="f_flags" value="&#10005;&#160;&lt;b&gt;410 Gone&lt;/b&gt; (exhausted / tombstoned)&#10;&#10005;&#160;&lt;b&gt;401&lt;/b&gt; mfa_required / mfa_failed&#10;&#10005;&#160;&lt;b&gt;403&lt;/b&gt; max_reads" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=11;fontColor=#8a302b;" vertex="1" parent="1"><mxGeometry x="850" y="947" width="300" height="66" as="geometry"/></mxCell>

        <mxCell id="a_kofn" value="&lt;b&gt;K-of-N threshold gate&lt;/b&gt;&#10;distinct approvers (live signatories ∪ advance grants) ≥ K?&#10;present an approved X-Blackbook-Request-Id" style="rhombus;whiteSpace=wrap;html=1;shadow=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="325" y="1066" width="380" height="118" as="geometry"/></mxCell>
        <mxCell id="f_kofn" value="&#10005;&#160;&lt;b&gt;412 Precondition Failed&lt;/b&gt;&#10;returns the (deduped) request id — approve out-of-band, then --request-id / --wait" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=11;fontColor=#8a302b;" vertex="1" parent="1"><mxGeometry x="850" y="1098" width="300" height="66" as="geometry"/></mxCell>

        <mxCell id="a_claim" value="&lt;b&gt;atomic read-claim&lt;/b&gt;&#160;(reads)&#10;UPDATE … SET read_count=read_count+1 WHERE read_count &lt; cap RETURNING&#10;closes the TOCTOU race on max_reads / delete_on_read" style="rhombus;whiteSpace=wrap;html=1;shadow=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="325" y="1220" width="380" height="118" as="geometry"/></mxCell>
        <mxCell id="f_claim" value="&#10005;&#160;&lt;b&gt;403 max_reads&lt;/b&gt;&#10;lost the claim race" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=11;fontColor=#8a302b;" vertex="1" parent="1"><mxGeometry x="850" y="1252" width="300" height="50" as="geometry"/></mxCell>

        <mxCell id="a_handler" value="&#9989;&#160;&lt;b&gt;Handler executes&lt;/b&gt;&#160;—&#160;crypto core + persistence&#10;post-read effects: delete_on_read · tombstone(max_reads) · rotate_on_read" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=1;fillColor=#d5e8d4;strokeColor=#5b8a3f;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#3f6b2f;" vertex="1" parent="1"><mxGeometry x="345" y="1372" width="360" height="54" as="geometry"/></mxCell>

        <mxCell id="a_audit" value="&lt;b&gt;&lt;font color=&quot;#3f6b2f&quot;&gt;Audit append&lt;/font&gt;&lt;/b&gt;&#10;keyed SHA3-256 chain&#10;&lt;i&gt;records every outcome —&#10;successes AND denials&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="1360" width="220" height="78" as="geometry"/></mxCell>
        <mxCell id="a_resp" value="&lt;b&gt;200 / 201&lt;/b&gt;&#10;response" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;shadow=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#2f5076;" vertex="1" parent="1"><mxGeometry x="770" y="1372" width="200" height="54" as="geometry"/></mxCell>

        <mxCell id="pe0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#5b8a3f;strokeWidth=2;" edge="1" parent="1" source="a_req" target="a_tls"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe1" value="pass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#5b8a3f;strokeWidth=2;fontSize=10;fontColor=#3f6b2f;labelBackgroundColor=#eef6ea;" edge="1" parent="1" source="a_tls" target="a_onconnect"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#5b8a3f;strokeWidth=2;" edge="1" parent="1" source="a_onconnect" target="a_auth"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe3" value="pass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#5b8a3f;strokeWidth=2;fontSize=10;fontColor=#3f6b2f;labelBackgroundColor=#eef6ea;" edge="1" parent="1" source="a_auth" target="a_domain"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe4" value="pass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#5b8a3f;strokeWidth=2;fontSize=10;fontColor=#3f6b2f;labelBackgroundColor=#eef6ea;" edge="1" parent="1" source="a_domain" target="a_acl"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe5" value="pass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#5b8a3f;strokeWidth=2;fontSize=10;fontColor=#3f6b2f;labelBackgroundColor=#eef6ea;" edge="1" parent="1" source="a_acl" target="a_store"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#5b8a3f;strokeWidth=2;" edge="1" parent="1" source="a_store" target="a_flags"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe7" value="pass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#5b8a3f;strokeWidth=2;fontSize=10;fontColor=#3f6b2f;labelBackgroundColor=#eef6ea;" edge="1" parent="1" source="a_flags" target="a_kofn"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe8" value="pass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#5b8a3f;strokeWidth=2;fontSize=10;fontColor=#3f6b2f;labelBackgroundColor=#eef6ea;" edge="1" parent="1" source="a_kofn" target="a_claim"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe9" value="claimed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#5b8a3f;strokeWidth=2;fontSize=10;fontColor=#3f6b2f;labelBackgroundColor=#eef6ea;" edge="1" parent="1" source="a_claim" target="a_handler"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#5b8a3f;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_handler" target="a_resp"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe11" value="every outcome" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;strokeColor=#9aa7bd;strokeWidth=1.5;fontSize=10;fontColor=#5b6b7e;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_handler" target="a_audit"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="xf1" value="fail" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;strokeColor=#c0706c;strokeWidth=1.5;fontSize=10;fontColor=#a23b36;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a_tls" target="f_tls"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="xf2" value="fail" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;strokeColor=#c0706c;strokeWidth=1.5;fontSize=10;fontColor=#a23b36;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a_auth" target="f_auth"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="xf3" value="fail" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;strokeColor=#c0706c;strokeWidth=1.5;fontSize=10;fontColor=#a23b36;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a_domain" target="f_domain"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="xf4" value="fail" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;strokeColor=#c0706c;strokeWidth=1.5;fontSize=10;fontColor=#a23b36;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a_acl" target="f_acl"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="xf5" value="fail" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;strokeColor=#c0706c;strokeWidth=1.5;fontSize=10;fontColor=#a23b36;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a_store" target="f_store"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="xf6" value="fail" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;strokeColor=#c0706c;strokeWidth=1.5;fontSize=10;fontColor=#a23b36;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a_flags" target="f_flags"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="xf7" value="fail" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;strokeColor=#c0706c;strokeWidth=1.5;fontSize=10;fontColor=#a23b36;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a_kofn" target="f_kofn"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="xf8" value="fail" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;strokeColor=#c0706c;strokeWidth=1.5;fontSize=10;fontColor=#a23b36;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a_claim" target="f_claim"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="p3_keys" name="3 · Key Hierarchy &amp; Crypto">
    <mxGraphModel dx="1422" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="k_bar" style="rounded=1;arcSize=40;fillColor=#9673a6;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="6" height="46" as="geometry"/></mxCell>
        <mxCell id="k_title" value="Key Hierarchy &amp; Cryptography" style="text;html=1;fontSize=22;fontStyle=1;align=left;fontColor=#1f2d3d;" vertex="1" parent="1"><mxGeometry x="60" y="16" width="700" height="28" as="geometry"/></mxCell>
        <mxCell id="k_subt" value="blackbook_core.rs · persistence.rs · credstore.rs&#160;&#160;—&#160;&#160;one root key fans out into domain-separated children; each child seals exactly one thing." style="text;html=1;fontSize=12;align=left;fontColor=#5b6b7e;" vertex="1" parent="1"><mxGeometry x="61" y="44" width="1100" height="18" as="geometry"/></mxCell>

        <mxCell id="dek_mode" value="&lt;b&gt;&lt;font color=&quot;#9a7d12&quot;&gt;DEK resolution at boot&lt;/font&gt;&lt;/b&gt;&#160;&lt;font color=&quot;#7e8aa0&quot;&gt;(dek.mode pins the choice)&lt;/font&gt;&#10;raw: 32 B key on the data volume&#160;&#160;|&#160;&#160;passphrase: DEK = scrypt($BLACKBOOK_MASTER_PASSPHRASE, salt) — only salt on disk" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="76" width="700" height="56" as="geometry"/></mxCell>
        <mxCell id="dek_box" value="&lt;b&gt;DEK&lt;/b&gt;&#10;unwraps master.bbkey" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1.5;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="790" y="76" width="220" height="56" as="geometry"/></mxCell>

        <mxCell id="prim" value="&lt;b&gt;&lt;font color=&quot;#5b3f76&quot; style=&quot;font-size:14px&quot;&gt;PrimaryKey&lt;/font&gt;&lt;/b&gt;&#160;&#160;root&#10;32-byte CSPRNG secret · pure material, no derivation method" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=1;fillColor=#e1d5e7;gradientColor=#f6f1fb;gradientDirection=north;strokeColor=#9673a6;strokeWidth=2;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="530" y="156" width="420" height="62" as="geometry"/></mxCell>
        <mxCell id="wrap" value="&lt;b&gt;WrappedKey&lt;/b&gt;&#160;—&#160;self-protection&#10;30 × RFC 3394 AES-256 key-wrap; each round's KEK = SecondaryKey::handle_with_info(round)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1.5;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="990" y="156" width="420" height="62" as="geometry"/></mxCell>

        <mxCell id="sec_l1" value="&lt;b&gt;secret_layer1&lt;/b&gt;&#10;&lt;font color=&quot;#9a8bb0&quot;&gt;secret/layer1/v1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=1;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1.5;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="sec_l2" value="&lt;b&gt;secret_layer2&lt;/b&gt;&#10;&lt;font color=&quot;#9a8bb0&quot;&gt;secret/layer2/v1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=1;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1.5;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="288" y="300" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="sec_fk" value="&lt;b&gt;file_dek_kek&lt;/b&gt;&#10;&lt;font color=&quot;#9a8bb0&quot;&gt;file/dek-kek/v1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=1;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1.5;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="516" y="300" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="sec_idx" value="&lt;b&gt;index&lt;/b&gt;&#10;&lt;font color=&quot;#9a8bb0&quot;&gt;index/v1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=1;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1.5;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="744" y="300" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="sec_hmac" value="&lt;b&gt;hmac&lt;/b&gt;&#10;&lt;font color=&quot;#9a8bb0&quot;&gt;hmac/v1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=1;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1.5;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="972" y="300" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="sec_mfa" value="&lt;b&gt;mfa_secret_kek&lt;/b&gt;&#10;&lt;font color=&quot;#9a8bb0&quot;&gt;mfa/secret-kek/v1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=1;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1.5;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1200" y="300" width="210" height="60" as="geometry"/></mxCell>
        <mxCell id="sec_note" value="SecondaryKey { primary, domain, kdf } — the domain string is mandatory + immutable, enforced at construction so two call sites can't share a key.&#160;&#160;kdf = scrypt(n=2¹², r=16, p=4) or PBKDF2-HMAC-SHA3-512 (200k)." style="text;html=1;fontSize=10;align=center;fontColor=#6c4f86;" vertex="1" parent="1"><mxGeometry x="60" y="368" width="1350" height="16" as="geometry"/></mxCell>

        <mxCell id="use_secret" value="&lt;b&gt;&lt;font color=&quot;#3f6b2f&quot;&gt;String secret envelope&lt;/font&gt;&lt;/b&gt;&#10;2 layers: l2 = enc( l1 = enc(plain, layer1), layer2 )&#10;per-message: ts(5) ‖ salt(32) ‖ AES-256-GCM(key=scrypt(k,salt), nonce=salt[..12], aad=ts)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="404" width="428" height="96" as="geometry"/></mxCell>
        <mxCell id="use_file" value="&lt;b&gt;&lt;font color=&quot;#3f6b2f&quot;&gt;File envelope&lt;/font&gt;&lt;/b&gt;&#10;random per-file DEK · AES-256-GCM blob&#10;DEK wrapped under file_dek_kek&#10;SHA3-256 plaintext hash verified on read" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="516" y="404" width="200" height="96" as="geometry"/></mxCell>
        <mxCell id="idxder" value="&lt;b&gt;&lt;font color=&quot;#6c4f86&quot;&gt;Index-derived keys&lt;/font&gt;&lt;/b&gt;&#10;metadata_enc_key = handle_with_info(&quot;metadata-enc/v1&quot;)&#10;→ AEAD on every identifier at rest&#10;name_index_key = handle()&#10;→ HMAC SHA3-256 *_id lookup columns" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1.5;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="744" y="404" width="200" height="110" as="geometry"/></mxCell>
        <mxCell id="audit_k" value="&lt;b&gt;&lt;font color=&quot;#6c4f86&quot;&gt;audit_hmac_key&lt;/font&gt;&lt;/b&gt;&#10;= hmac.handle()&#10;keyed SHA3-256 chain over&#10;prev_hash ‖ fields&#10;→ tamper-evident audit" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1.5;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="972" y="404" width="200" height="96" as="geometry"/></mxCell>
        <mxCell id="use_mfa" value="&lt;b&gt;&lt;font color=&quot;#3f6b2f&quot;&gt;TOTP secret at rest&lt;/font&gt;&lt;/b&gt;&#10;encrypt_aes_gcm(secret, mfa_secret_kek)&#10;RFC 6238 · SHA1 · 30s · 6 digits" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1200" y="404" width="210" height="96" as="geometry"/></mxCell>

        <mxCell id="argon" value="&lt;b&gt;&lt;font color=&quot;#345d8a&quot;&gt;Argon2id — password paths ONLY&lt;/font&gt;&lt;/b&gt;&#160;&lt;font color=&quot;#7e8aa0&quot;&gt;(credstore.rs)&lt;/font&gt;&#10;64 MiB · t=3 · p=1&#10;①&#160;profile unlock KEK (Phase 2)&#160;&#160;&#160;②&#160;explicit external passphrase (Phase 3)&#10;&lt;i&gt;deliberately separate from the server's per-message scrypt, which keys off high-entropy material and must stay fast&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;fillColor=#dae8fc;gradientColor=#f3f7fd;gradientDirection=north;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="556" width="656" height="120" as="geometry"/></mxCell>
        <mxCell id="atrest" value="&lt;b&gt;&lt;font color=&quot;#9a6a00&quot;&gt;External rows — server at-rest re-wrap (Phase 1)&lt;/font&gt;&lt;/b&gt;&#10;the opaque client envelope is itself AEAD-sealed under metadata_enc_key before it touches the DB,&#10;so a stolen database is worthless without the server's BlackbookKey — yet the server still can't read the client plaintext." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;fillColor=#ffe6cc;gradientColor=#fff6ec;gradientDirection=north;strokeColor=#d79b00;strokeWidth=1.5;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="744" y="556" width="666" height="120" as="geometry"/></mxCell>

        <mxCell id="ke1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#9673a6;strokeWidth=1.5;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dek_box" target="prim"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ke2" value="self-wrap" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;strokeColor=#b9a7c9;strokeWidth=1.5;fontSize=10;fontColor=#6c4f86;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="wrap" target="prim"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ke3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#9673a6;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="prim" target="sec_l1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ke4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#9673a6;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="prim" target="sec_l2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ke5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#9673a6;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="prim" target="sec_fk"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ke6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#9673a6;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="prim" target="sec_idx"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ke7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#9673a6;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="prim" target="sec_hmac"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ke8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#9673a6;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="prim" target="sec_mfa"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ke9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#82b366;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sec_l1" target="use_secret"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ke10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#82b366;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sec_l2" target="use_secret"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ke11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#82b366;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sec_fk" target="use_file"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ke12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#82b366;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sec_mfa" target="use_mfa"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ke13" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#9673a6;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sec_idx" target="idxder"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ke15" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#9673a6;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sec_hmac" target="audit_k"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ke16" value="seals" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;strokeColor=#d79b00;strokeWidth=1.5;fontSize=10;fontColor=#9a6a00;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="idxder" target="atrest"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="p4_storage" name="4 · Client-Side Storage Models">
    <mxGraphModel dx="1422" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="m_bar" style="rounded=1;arcSize=40;fillColor=#6c8ebf;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="6" height="46" as="geometry"/></mxCell>
        <mxCell id="m_title" value="Client-Side (&quot;external&quot;) Storage" style="text;html=1;fontSize=22;fontStyle=1;align=left;fontColor=#1f2d3d;" vertex="1" parent="1"><mxGeometry x="60" y="16" width="800" height="28" as="geometry"/></mxCell>
        <mxCell id="m_sub" value="Two key modes (who holds the wrapping key) × two storage models (where the ciphertext lives). The server can never read the plaintext in any external mode." style="text;html=1;fontSize=12;align=left;fontColor=#5b6b7e;" vertex="1" parent="1"><mxGeometry x="61" y="44" width="1200" height="18" as="geometry"/></mxCell>

        <mxCell id="kmode" value="&lt;b&gt;&lt;font color=&quot;#9a7d12&quot;&gt;Key modes&lt;/font&gt;&lt;/b&gt;&#160;&lt;font color=&quot;#7e8aa0&quot;&gt;(apply to both models, chosen automatically)&lt;/font&gt;&#10;&lt;b&gt;CMK&lt;/b&gt; (default, no passphrase): kek = profile's rotation-stable Client Master Key — carried forward across re-login, so client rotate never orphans data.&#10;&lt;b&gt;Passphrase&lt;/b&gt; (explicit): kek = Argon2id(passphrase, salt) — portable, decoupled from the profile.&#10;Versioned envelope v2:  0x02 | mode(0=CMK / 1=Argon2) | m,t,p(4 ea) | salt | wrapped_dek | ct      (legacy v1 = scrypt-passphrase still decodes)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="78" width="1410" height="104" as="geometry"/></mxCell>

        <mxCell id="ek_lane" value="MODEL ①&#160;&#160;EXTERNAL-KEY&#160;&#160;·&#160;&#160;put --external / file put -e" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;verticalAlign=top;align=center;spacingTop=10;fontSize=13;fontStyle=1;fontColor=#6c4f86;fillColor=#e1d5e7;gradientColor=#f7f3f9;gradientDirection=north;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="208" width="690" height="560" as="geometry"/></mxCell>
        <mxCell id="res_lane" value="MODEL ②&#160;&#160;RESIDENT&#160;&#160;·&#160;&#160;file put -E / --resident&#160;&#160;·&#160;&#160;mutual custody" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;verticalAlign=top;align=center;spacingTop=10;fontSize=13;fontStyle=1;fontColor=#2f5076;fillColor=#dae8fc;gradientColor=#f3f7fd;gradientDirection=north;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="760" y="208" width="690" height="560" as="geometry"/></mxCell>

        <mxCell id="ek_crypto" value="&lt;b&gt;&lt;font color=&quot;#6c4f86&quot;&gt;Seal (client)&lt;/font&gt;&lt;/b&gt;&#10;K = random 256-bit data key&#10;ct = AES-256-GCM(K, value)&#10;wrapped_dek = AES-256-GCM(kek, K)&#10;envelope = { mode, salt, wrapped_dek, ct }" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1.5;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="70" y="256" width="630" height="106" as="geometry"/></mxCell>
        <mxCell id="ek_client" value="&lt;b&gt;&lt;font color=&quot;#3f6b2f&quot;&gt;Client holds&lt;/font&gt;&lt;/b&gt;&#10;the key factor only&#10;(CMK in the encrypted profile, or the passphrase)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="70" y="392" width="300" height="86" as="geometry"/></mxCell>
        <mxCell id="ek_server" value="&lt;b&gt;&lt;font color=&quot;#9a6a00&quot;&gt;Server holds&lt;/font&gt;&lt;/b&gt;&#10;whole envelope (secret) or header+blob (file)&#10;&lt;i&gt;re-wrapped under metadata_enc at rest&lt;/i&gt;&#10;cannot open — no kek" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="400" y="392" width="300" height="86" as="geometry"/></mxCell>
        <mxCell id="ek_get" value="&lt;b&gt;get&lt;/b&gt;&#160;—&#160;server releases the envelope after all gates; client unwraps K with kek, decrypts ct locally." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1.5;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="70" y="510" width="630" height="56" as="geometry"/></mxCell>
        <mxCell id="ek_custody" value="&lt;b&gt;Custody&lt;/b&gt;&#160;&#160;bytes live in blackbook; only the wrap key is client-side.&#10;Server compromise alone → ciphertext only.&#160;&#160;Lost key factor → unrecoverable." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;fillColor=#f4f4f4;strokeColor=#999999;strokeWidth=1.5;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="70" y="598" width="630" height="64" as="geometry"/></mxCell>
        <mxCell id="ek_max" value="&#9888;&#160;&lt;b&gt;max_reads&lt;/b&gt; tombstone scrubs external_envelope → 410 Gone thereafter." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=11;fontColor=#8a302b;align=center;" vertex="1" parent="1"><mxGeometry x="70" y="694" width="630" height="44" as="geometry"/></mxCell>

        <mxCell id="res_crypto" value="&lt;b&gt;&lt;font color=&quot;#2f5076&quot;&gt;Seal (client) — split key&lt;/font&gt;&lt;/b&gt;&#10;Kf = random file key&#160;&#160;ct = AES-256-GCM(Kf, file)&#160;&#160;→ stash&#10;Kf_c = random client half&#160;&#160;Kf_s = Kf ⊕ Kf_c&#160;&#160;→ server&#10;wrapped_c = AES-256-GCM(kek, Kf_c)&#160;&#160;→ stash header" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="790" y="256" width="630" height="106" as="geometry"/></mxCell>
        <mxCell id="res_client" value="&lt;b&gt;&lt;font color=&quot;#3f6b2f&quot;&gt;Client holds — resident stash&lt;/font&gt;&lt;/b&gt;&#10;~/.bbk/resident/&amp;lt;id&amp;gt;.bbkr&#10;= BBKR | header(wrapped_c, mode) | ct&#10;+ index.json (name → stash)&#10;&lt;i&gt;the ciphertext never leaves this machine&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="790" y="392" width="300" height="106" as="geometry"/></mxCell>
        <mxCell id="res_server" value="&lt;b&gt;&lt;font color=&quot;#9a6a00&quot;&gt;Server holds — manifest&lt;/font&gt;&lt;/b&gt;&#10;external_kind = 2&#10;server_key_component = Kf_s&#10;(wrapped under file_dek_kek) · hash · size&#10;blob = empty (or opaque backup if --server-copy)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1120" y="392" width="300" height="106" as="geometry"/></mxCell>
        <mxCell id="res_get" value="&lt;b&gt;get&lt;/b&gt;&#160;—&#160;server returns Kf_s in X-Blackbook-Key-Component after all gates (empty body); client reads its stash, recovers Kf_c via kek, Kf = Kf_c ⊕ Kf_s, decrypts ct locally." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="790" y="514" width="630" height="64" as="geometry"/></mxCell>
        <mxCell id="res_custody" value="&lt;b&gt;Custody&lt;/b&gt;&#160;&#160;neither party can decrypt alone. Server never sees Kf_c; client can't get Kf_s without passing every auth/ACL/K-of-N/MFA gate.&#10;Lost stash → unrecoverable unless --server-copy was used (still opaque to the server). --shred removes the original plaintext." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;fillColor=#f4f4f4;strokeColor=#999999;strokeWidth=1.5;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="790" y="606" width="630" height="86" as="geometry"/></mxCell>
        <mxCell id="res_max" value="&#9888;&#160;&lt;b&gt;max_reads&lt;/b&gt; tombstone NULLs server_key_component → permanently unrecoverable even though the client still holds ct." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=11;fontColor=#8a302b;align=center;" vertex="1" parent="1"><mxGeometry x="790" y="708" width="630" height="44" as="geometry"/></mxCell>

        <mxCell id="me1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#9673a6;strokeWidth=1.5;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ek_crypto" target="ek_client"><mxGeometry relative="1" as="geometry"/></mxCell>
