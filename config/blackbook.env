# Blackbook Environment Configuration — EXAMPLE / TEMPLATE
#
# docker-compose.yml reads variables from a `.env` file in the project root (and
# from your shell), NOT from this file. To use these values:
#     cp config/blackbook.env .env   &&   $EDITOR .env   # then change every password
# The variable names below are exactly the ones docker-compose.yml substitutes
# (DB_ADMIN_USER/DB_ADMIN_PASSWORD, DB_USER/DB_PASSWORD, BACKUP_PASSWORD, DB_NAME).

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL Admin User (created by PostgreSQL during initialization)
DB_ADMIN_USER=blackbook_admin

# PostgreSQL Admin Password
# IMPORTANT: Change this to a strong password in production
# Generate with: openssl rand -base64 32
DB_ADMIN_PASSWORD=secure_default_admin_password_change_me_in_production

# PostgreSQL Database Name
DB_NAME=blackbook

# Application Database User
# This user has limited privileges (least privilege principle)
DB_USER=blackbook_app

# Application Database Password
# IMPORTANT: Change this to a strong password in production
# Generate with: openssl rand -base64 32
DB_PASSWORD=secure_default_app_password_change_me_in_production

# Backup User Password (for scheduled backups)
# IMPORTANT: Change this to a strong password in production
BACKUP_PASSWORD=secure_default_backup_password_change_me_in_production

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# Logging Level (debug, info, warn, error)
RUST_LOG=info

# Rust Backtrace for debugging (0, 1, or full)
RUST_BACKTRACE=1

# HTTPS Configuration
BLACKBOOK_HTTPS_PORT=8443

# Security Settings
SECURE_DEFAULTS=true
DISABLE_HTTP=true

# ============================================================================
# DOCKER CONFIGURATION
# ============================================================================

# Compose Project Name (for container naming)
COMPOSE_PROJECT_NAME=blackbook

# ============================================================================
# PRODUCTION SECURITY RECOMMENDATIONS
# ============================================================================

# Before deploying to production:
#
# 1. Generate strong passwords:
#    Linux/Mac: openssl rand -base64 32
#    PowerShell: [Convert]::ToBase64String([byte[]](1..32 | ForEach-Object {[Random]::new().Next(0,256)}))
#
# 2. Update all password variables above with generated values
#
# 3. Store .env file securely:
#    - Not in version control
#    - Restrict file permissions: chmod 600 .env
#    - Encrypt in transit
#    - Regular access audits
#
# 4. Use a secrets management system in production:
#    - Docker Secrets (Swarm mode)
#    - HashiCorp Vault
#    - AWS Secrets Manager
#    - Azure Key Vault
#    - Other enterprise secret management
#
# 5. Rotate passwords regularly:
#    - Database passwords
#    - Application passwords
#    - Backup passwords
#
# 6. Monitor database access:
#    - Enable PostgreSQL audit logging
#    - Track failed authentication attempts
#    - Alert on unusual activity
#
# 7. Enable SSL/TLS:
#    - Generate certificates from trusted CA
#    - Update docker-compose.yml with cert paths
#    - Force HTTPS connections
#    - Disable HTTP
#
# 8. Network security:
#    - Run in isolated Docker network (already configured)
#    - Use firewall rules
#    - Restrict access by IP address
#    - Use VPN/secure tunnels for remote access

# ============================================================================
# CONTAINER RESOURCE LIMITS
# ============================================================================

# Memory limits are configured in docker-compose.yml
# Default: 512MB limit, 256MB reservation
#
# Adjust based on your workload:
# Light: 256MB limit
# Normal: 512MB limit
# Heavy: 1GB limit
#
# CPU limits are configured in docker-compose.yml
# Default: 2 CPUs limit, 1 CPU reservation

# ============================================================================
# DATABASE BACKUP CONFIGURATION
# ============================================================================

# Enable automated backups (future feature)
# ENABLE_BACKUPS=true
# BACKUP_SCHEDULE=0 2 * * *  # 2 AM daily
# BACKUP_RETENTION_DAYS=30
# BACKUP_LOCATION=/backups

# ============================================================================
# MONITORING AND ALERTING
# ============================================================================

# Enable Prometheus metrics (future feature)
# ENABLE_METRICS=true
# METRICS_PORT=9090

# Enable tracing (future feature)
# ENABLE_TRACING=true
# JAEGER_ENDPOINT=http://jaeger:6828

# ============================================================================
# DEVELOPMENT SETTINGS (do NOT use in production)
# ============================================================================

# Enable debug logging (verbose output)
# DEBUG=true

# Enable CORS for testing
# ALLOW_CORS=true

# Accept self-signed certificates for testing
# INSECURE_TLS=true

# ============================================================================
# NOTES
# ============================================================================

# This file is automatically loaded by docker-compose.yml
# Changes take effect after: docker-compose restart
#
# View current configuration: docker-compose config
# Troubleshoot: docker-compose logs -f
#
# Security best practices:
# 1. Never commit .env to version control
# 2. Use .env.example as template only
# 3. Rotate passwords regularly
# 4. Use strong, unique passwords
# 5. Audit access to .env file
# 6. Log all configuration changes
